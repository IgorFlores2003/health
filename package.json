{
  "name": "ritmo-health",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "db:init": "npx --yes supabase@2 init",
    "db:login": "npx --yes supabase@2 login",
    "db:link": "npx --yes supabase@2 link",
    "db:migrate": "npx --yes supabase@2 db push --linked",
    "db:status": "npx --yes supabase@2 migration list --linked",
    "auth:configure": "node scripts/configure-auth.mjs",
    "auth:check": "node scripts/configure-auth.mjs --check",
    "ai:deploy": "npx --yes supabase@2 functions deploy coach --use-api"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.87.1",
    "lucide-react": "^1.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
