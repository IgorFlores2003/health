# Configuração administrativa local. Nunca use prefixo VITE_ nestes segredos.
# Token de acesso pessoal (PAT), não a chave anon/publishable/service_role.
SUPABASE_ACCESS_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
# Senha de app do Google (16 letras); não a senha da conta.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=seu-email@gmail.com
SMTP_FROM_NAME=Ritmo
